      <column caption='DTI Bucket' datatype='string' name='[Calculation_1409591445549056]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0226789729558533] &lt; 0.2 THEN &quot;Low (&lt;20%)&quot;&#13;&#10;ELSEIF [Calculation_0226789729558533]&lt; 0.4 THEN &quot;Medium (20-40%)&quot;&#13;&#10;ELSE &quot;High (&gt;40%)&quot;&#13;&#10;END' />
      </column>
      <column caption='Default Status' datatype='string' name='[Calculation_1409591445995521]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [default_flag] = 1 THEN &quot;Defaulted&quot; ELSE &quot;Paid&quot; END' />
      </column>
      <column caption='Age Bucket' datatype='string' name='[Calculation_1409591466373122]' role='dimension' type='nominal'>
